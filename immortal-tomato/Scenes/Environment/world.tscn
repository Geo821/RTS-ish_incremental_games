[sub_resource type="GDScript" id="GDScript_lrwwn"]
script/source = "extends Node2D



func spawn_unit(new_pos: Vector2):
	var new_unit := preload(\"res://Scenes/Characters/unit.tscn\").instantiate()
	new_unit.global_position = new_pos
	add_child(new_unit)
	Global.total_units += 1

func spawn_all_units():
	for x in 5:
		for y in 5:
			#spawn_unit(Vector2(x*16-320/2,y*16-180/2))
			#spawn_unit(Vector2(x*16,y*16)-Vector2(Global.world_border_left/2,Global.world_border_up/2))
			spawn_unit(Vector2(x*16,y*16))

func _ready() -> void:
	spawn_all_units()
"

[sub_resource type="GDScript" id="GDScript_nk58a"]
script/source = "extends RichTextLabel

func _process(delta: float) -> void:
	text = \" FPS: %d\\n Selected Units %d\\n Total Units %d\"%[Engine.get_frames_per_second(),Global.total_units_selected,Global.total_units]
"

[sub_resource type="GDScript" id="GDScript_y7w0j"]
script/source = "extends Camera2D

var drag: bool = false

@export var zoom_speed: float = 0.1
@export var min_zoom: float = 0.5
@export var max_zoom: float = 2
@export var initial_zoom: float = 1.5
@export var acceleration: float = 1

#var bounds_up: int = -300
#var bounds_down: int = 300
#var bounds_left: int = -300
#var bounds_right: int = 300

#func _ready() -> void:
	#zoom = Vector2.ONE * Stats.camera_zoom
	#global_position = Stats.camera_position

func _input(event: InputEvent) -> void:
	if !get_tree().paused:
		if event is InputEventMouseButton and (event.button_index == 3):
			drag = event.is_pressed()

		if event is InputEventMouseMotion:
			if drag:
				global_position -= event.relative * acceleration / zoom
				global_position.x = clamp(global_position.x, Global.world_border_left/2, Global.world_border_right/2)
				global_position.y = clamp(global_position.y, Global.world_border_up/2, Global.world_border_down/2)
				#global_position.x = clamp(global_position.x, bounds_left, bounds_right)
				#global_position.y = clamp(global_position.y, bounds_up, bounds_down)
				#Stats.camera_position = global_position

		if event is InputEventMouseButton and event.pressed:
			if event.button_index == MOUSE_BUTTON_WHEEL_UP and zoom.x < max_zoom:
				zoom += Vector2.ONE * zoom_speed
				#Stats.camera_zoom = zoom.x
			elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN and zoom.x > min_zoom:
				zoom -= Vector2.ONE * zoom_speed
				#Stats.camera_zoom = zoom.x
"

[sub_resource type="GDScript" id="GDScript_ygic0"]
script/source = "extends Node2D



@export var axis_color: Color = Color(1,1,1,1):
	set(value):
		axis_color = value
		queue_redraw()

func _draw() -> void:
	#var world_rect: Rect2 = Rect2(Vector2(-360,-180),Vector2(360,180))
	var world_rect: Rect2 = Rect2(Vector2(Global.world_border_left/2,Global.world_border_up/2),Vector2(Global.world_border_right*2-80,Global.world_border_down*2))
	draw_rect(world_rect,Color(1,1,1,1),false,2)
	var default_font : Font = ThemeDB.fallback_font
	for i in get_viewport().size.x/2:
		draw_line(Vector2(i*10,0),Vector2(i*10,5),axis_color)
		draw_line(Vector2(-360+i*10,-180),Vector2(-360 + i*10,-180 + 5),axis_color)
		draw_string(default_font,Vector2(i * 10 - 2, 8),str(i*10),HORIZONTAL_ALIGNMENT_LEFT,-1,4,axis_color)
		draw_string(default_font,Vector2(i * 10 - 2 - 360, 8 - 180),str(i*10),HORIZONTAL_ALIGNMENT_LEFT,-1,4,axis_color)
	for i in get_viewport().size.y/2:
		draw_line(Vector2(0,i*10),Vector2(5,i*10),axis_color)
		draw_line(Vector2(0,i*10),Vector2(5,i*10),axis_color)
		draw_string(default_font,Vector2(8, i * 10 + 2),str(i*10),HORIZONTAL_ALIGNMENT_LEFT,-1,4,axis_color)
		draw_string(default_font,Vector2(-360 + 8, i * 10 + 2 - 180),str(i*10),HORIZONTAL_ALIGNMENT_LEFT,-1,4,axis_color)
"

